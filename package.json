{
  "name": "cit-physical-xr",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source, local-first educational physical and XR programming foundation.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.17.0 <23",
    "pnpm": ">=10.28.0 <11"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "format:check": "prettier --check . && uv run ruff format --check .",
    "generate": "node tools/protocol-codegen/generate.mjs && node tools/config-codegen/sync.mjs",
    "generate:check": "node tools/protocol-codegen/generate.mjs --check && node tools/config-codegen/sync.mjs --check",
    "lint": "eslint . --max-warnings 0 && uv run ruff check .",
    "quest:check": "node tools/validation/validate-godot-scaffold.mjs",
    "schema:check": "node tools/validation/validate-schemas.mjs",
    "secret:check": "node tools/validation/check-secrets.mjs",
    "test": "pnpm test:ts && pnpm test:py",
    "test:py": "uv run pytest",
    "test:ts": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck && uv run mypy",
    "license:check": "node tools/license-check/check.mjs",
    "sbom": "uv run python tools/sbom/generate.py"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "3.2.7",
    "yaml": "2.9.0"
  }
}
