{
  "schemaVersion": "1.0",
  "coursePackId": "smart-ring-device-control",
  "version": "1.0.0",
  "displayName": "R1 smart-ring device control",
  "description": "Uses structured Even R1 touch gestures as an input for up to eight assigned ground robots. Scroll up/down sends one short bounded forward/backward cue, tap requests zero velocity, and double-tap may start only the separately armed Tello fleet sequence.",
  "roles": [
    {
      "role": "smart_ring_input",
      "ioType": "input",
      "oneOfCapabilities": ["interaction.gesture.smart_ring"],
      "optional": false
    },
    {
      "role": "ground_output_1",
      "ioType": "output",
      "oneOfCapabilities": ["mobility.ground.set_velocity"],
      "optional": true
    },
    {
      "role": "ground_output_2",
      "ioType": "output",
      "oneOfCapabilities": ["mobility.ground.set_velocity"],
      "optional": true
    },
    {
      "role": "ground_output_3",
      "ioType": "output",
      "oneOfCapabilities": ["mobility.ground.set_velocity"],
      "optional": true
    },
    {
      "role": "ground_output_4",
      "ioType": "output",
      "oneOfCapabilities": ["mobility.ground.set_velocity"],
      "optional": true
    },
    {
      "role": "ground_output_5",
      "ioType": "output",
      "oneOfCapabilities": ["mobility.ground.set_velocity"],
      "optional": true
    },
    {
      "role": "ground_output_6",
      "ioType": "output",
      "oneOfCapabilities": ["mobility.ground.set_velocity"],
      "optional": true
    },
    {
      "role": "ground_output_7",
      "ioType": "output",
      "oneOfCapabilities": ["mobility.ground.set_velocity"],
      "optional": true
    },
    {
      "role": "ground_output_8",
      "ioType": "output",
      "oneOfCapabilities": ["mobility.ground.set_velocity"],
      "optional": true
    },
    {
      "role": "fleet_sequence_controller",
      "ioType": "output",
      "oneOfCapabilities": ["mobility.flight.fleet_sequence.start"],
      "optional": true
    }
  ],
  "flows": [
    {
      "flowId": "r1-scroll-up-to-ground-output-1",
      "version": 1,
      "trigger": {
        "event": "interaction.gesture.smart_ring",
        "minimumConfidence": 1,
        "debounceMs": 250,
        "payloadEquals": {
          "gesture": "scroll_up"
        }
      },
      "command": {
        "action": "mobility.ground.set_velocity",
        "fixedParameters": {
          "forwardMetersPerSecond": 0.12,
          "rightMetersPerSecond": 0,
          "clockwiseRadiansPerSecond": 0
        },
        "parameterBindings": []
      },
      "target": {
        "role": "ground_output_1"
      },
      "guards": [
        "session_is_active",
        "role_is_assigned",
        "target_is_connected",
        "target_is_armed",
        "instructor_override_is_clear"
      ],
      "safetyProfile": "classroom-ground-robot",
      "outputRoles": ["ground_output_1"],
      "parallelGroup": "r1-ground-control",
      "enabled": true
    },
