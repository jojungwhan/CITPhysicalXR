      "flowId": "synchronized-voice-ground-1",
      "version": 1,
      "trigger": {
        "event": "interaction.intent.device_control",
        "minimumConfidence": 1,
        "debounceMs": 250,
        "payloadEquals": {
          "target": "ground_outputs",
          "confirmed": true
        }
      },
      "command": {
        "action": "mobility.ground.nudge",
        "fixedParameters": {},
        "parameterBindings": [
          {
            "payloadField": "action",
            "parameter": "direction"
          }
        ]
      },
      "target": {
        "role": "ground_output_1"
      },
      "guards": [
        "session_is_active",
        "role_is_assigned",
        "target_is_connected",
        "target_is_armed",
        "instructor_override_is_clear"
      ],
      "safetyProfile": "classroom-drone-monitoring",
      "outputRoles": ["ground_output_1"],
      "parallelGroup": "synchronized-voice-ground",
      "enabled": true
