{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citxr.dev/schema/protocol/v1/cit-protocol.schema.json",
  "title": "CIT Physical XR Protocol V1",
  "description": "Language-neutral foundation messages. This schema does not authorize physical execution.",
  "oneOf": [
    { "$ref": "#/$defs/CitEnvelope" },
    { "$ref": "#/$defs/DeviceCommandIntent" },
    { "$ref": "#/$defs/DeviceEvent" },
    { "$ref": "#/$defs/DeviceDescriptor" },
    { "$ref": "#/$defs/CommandResult" },
    { "$ref": "#/$defs/ProtocolError" }
  ],
  "$defs": {
    "Identifier": {
      "title": "Identifier",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "CapabilityIdentifier": {
      "title": "CapabilityIdentifier",
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
    },
    "ActionIdentifier": {
      "title": "ActionIdentifier",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "JsonObject": {
      "title": "JsonObject",
      "type": "object",
      "additionalProperties": true
    },
    "CitEnvelope": {
      "title": "CitEnvelope",
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "messageId", "type", "sentAt", "payload"],
      "properties": {
        "protocolVersion": { "const": 1, "type": "integer" },
        "messageId": { "type": "string", "format": "uuid" },
        "type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "runtimeId": { "$ref": "#/$defs/Identifier" },
        "deviceId": { "$ref": "#/$defs/Identifier" },
        "clientId": { "$ref": "#/$defs/Identifier" },
        "sessionId": { "$ref": "#/$defs/Identifier" },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sequence": { "type": "integer", "minimum": 0 },
        "sentAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "payload": {}
      }
    },
    "SafetyContext": {
      "title": "SafetyContext",
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "armed"],
      "properties": {
        "policyId": { "$ref": "#/$defs/Identifier" },
        "armed": { "type": "boolean" },
        "deadmanActive": { "type": "boolean" },
        "inputConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "DeviceCommandIntent": {
      "title": "DeviceCommandIntent",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "sessionId",
        "deviceId",
        "capability",
        "action",
        "arguments",
        "source",
        "issuedAt",
        "expiresAt",
        "idempotencyKey",
        "safetyContext"
      ],
      "properties": {
        "commandId": { "type": "string", "format": "uuid" },
        "sessionId": { "$ref": "#/$defs/Identifier" },
        "deviceId": { "$ref": "#/$defs/Identifier" },
        "capability": { "$ref": "#/$defs/CapabilityIdentifier" },
        "action": { "$ref": "#/$defs/ActionIdentifier" },
        "arguments": { "$ref": "#/$defs/JsonObject" },
        "source": {
          "type": "string",
          "enum": [
            "student_blocks",
            "student_python",
            "quest",
            "leap",
            "instructor",
            "agent_mesh",
            "system"
          ]
        },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "safetyContext": { "$ref": "#/$defs/SafetyContext" }
      }
    },
    "DeviceEvent": {
      "title": "DeviceEvent",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "deviceId",
        "category",
        "name",
        "values",
        "receivedAt"
      ],
      "properties": {
        "eventId": { "type": "string", "format": "uuid" },
        "deviceId": { "$ref": "#/$defs/Identifier" },
        "sessionId": { "$ref": "#/$defs/Identifier" },
        "sequence": { "type": "integer", "minimum": 0 },
        "category": {
          "type": "string",
          "enum": [
            "connection",
            "input",
            "telemetry",
            "motion",
            "sensor",
            "safety",
            "program",
            "diagnostic"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "values": { "$ref": "#/$defs/JsonObject" },
        "sourceTimestamp": { "type": "string", "format": "date-time" },
        "receivedAt": { "type": "string", "format": "date-time" },
        "historical": { "type": "boolean", "default": false }
      }
    },
    "DeviceDescriptor": {
      "title": "DeviceDescriptor",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceId",
        "displayName",
        "deviceType",
        "model",
        "adapterId",
        "adapterVersion",
        "physical",
        "capabilities"
      ],
      "properties": {
        "deviceId": { "$ref": "#/$defs/Identifier" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "deviceType": {
          "type": "string",
          "enum": ["robot", "input", "xr_client", "virtual", "bridge"]
        },
        "model": { "$ref": "#/$defs/Identifier" },
        "adapterId": { "$ref": "#/$defs/Identifier" },
        "adapterVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "physical": { "type": "boolean" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/CapabilityIdentifier" }
        },
        "safetyProfile": { "$ref": "#/$defs/Identifier" }
      }
    },
    "CommandResult": {
      "title": "CommandResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["commandId", "deviceId", "status", "recordedAt"],
      "properties": {
        "commandId": { "type": "string", "format": "uuid" },
        "deviceId": { "$ref": "#/$defs/Identifier" },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "completed",
            "rejected",
            "duplicate",
            "expired",
            "failed"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "recordedAt": { "type": "string", "format": "date-time" },
        "details": { "$ref": "#/$defs/JsonObject" }
      }
    },
    "ProtocolError": {
      "title": "ProtocolError",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "correlationId", "recoverySuggestion"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "DEVICE_NOT_FOUND",
            "DEVICE_OFFLINE",
            "DEVICE_NOT_ASSIGNED",
            "DEVICE_LEASE_CONFLICT",
            "DEVICE_NOT_ARMED",
            "DEVICE_CAPABILITY_UNSUPPORTED",
            "COMMAND_EXPIRED",
            "COMMAND_DUPLICATE",
            "SAFETY_POLICY_DENIED",
            "PROTOCOL_VERSION_UNSUPPORTED",
            "INVALID_MESSAGE"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "deviceId": { "$ref": "#/$defs/Identifier" },
        "sessionId": { "$ref": "#/$defs/Identifier" },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recoverySuggestion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "details": { "$ref": "#/$defs/JsonObject" }
      }
    }
  }
}
