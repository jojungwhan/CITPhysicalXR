{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citxr.dev/schema/protocol/v1/cit-protocol.schema.json",
  "title": "CIT Physical XR Protocol V1",
  "description": "Language-neutral foundation messages. This schema does not authorize physical execution.",
  "oneOf": [
    {
      "$ref": "#/$defs/CitEnvelope"
    },
    {
      "$ref": "#/$defs/DeviceCommandIntent"
    },
    {
      "$ref": "#/$defs/DeviceEvent"
    },
    {
      "$ref": "#/$defs/DeviceDescriptor"
    },
    {
      "$ref": "#/$defs/PluginManifest"
    },
    {
      "$ref": "#/$defs/IntegrationNode"
    },
    {
      "$ref": "#/$defs/HealthReport"
    },
    {
      "$ref": "#/$defs/FabricEventEnvelope"
    },
    {
      "$ref": "#/$defs/FabricCommandRequest"
    },
    {
      "$ref": "#/$defs/FabricResolvedCommand"
    },
    {
      "$ref": "#/$defs/FabricCommandLifecycleEvent"
    },
    {
      "$ref": "#/$defs/CreateInteractionSessionRequest"
    },
    {
      "$ref": "#/$defs/InteractionSession"
    },
    {
      "$ref": "#/$defs/CoursePack"
    },
    {
      "$ref": "#/$defs/FlowRecipe"
    },
    {
      "$ref": "#/$defs/AdapterClientFrame"
    },
    {
      "$ref": "#/$defs/AdapterServerFrame"
    },
    {
      "$ref": "#/$defs/CommandResult"
    },
    {
      "$ref": "#/$defs/ProtocolError"
    }
  ],
  "$defs": {
    "Identifier": {
      "title": "Identifier",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "CapabilityIdentifier": {
      "title": "CapabilityIdentifier",
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
    },
    "ActionIdentifier": {
      "title": "ActionIdentifier",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "JsonObject": {
      "title": "JsonObject",
      "type": "object",
      "additionalProperties": true
    },
    "CitEnvelope": {
      "title": "CitEnvelope",
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "messageId", "type", "sentAt", "payload"],
      "properties": {
        "protocolVersion": {
          "const": 1,
          "type": "integer"
        },
        "messageId": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "runtimeId": {
          "$ref": "#/$defs/Identifier"
        },
        "deviceId": {
          "$ref": "#/$defs/Identifier"
        },
        "clientId": {
          "$ref": "#/$defs/Identifier"
        },
        "sessionId": {
          "$ref": "#/$defs/Identifier"
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "sentAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "payload": {}
      }
    },
    "SafetyContext": {
      "title": "SafetyContext",
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "armed"],
      "properties": {
        "policyId": {
          "$ref": "#/$defs/Identifier"
        },
        "armed": {
          "type": "boolean"
        },
        "deadmanActive": {
          "type": "boolean"
        },
        "inputConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "DeviceCommandIntent": {
      "title": "DeviceCommandIntent",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "sessionId",
        "deviceId",
        "capability",
        "action",
        "arguments",
        "source",
        "issuedAt",
        "expiresAt",
        "idempotencyKey",
        "safetyContext"
      ],
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "sessionId": {
          "$ref": "#/$defs/Identifier"
        },
        "deviceId": {
          "$ref": "#/$defs/Identifier"
        },
        "capability": {
          "$ref": "#/$defs/CapabilityIdentifier"
        },
        "action": {
          "$ref": "#/$defs/ActionIdentifier"
        },
        "arguments": {
          "$ref": "#/$defs/JsonObject"
        },
        "source": {
          "type": "string",
          "enum": [
            "student_blocks",
            "student_python",
            "quest",
            "leap",
            "instructor",
            "agent_mesh",
            "system"
          ]
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "safetyContext": {
          "$ref": "#/$defs/SafetyContext"
        }
      }
    },
    "DeviceEvent": {
      "title": "DeviceEvent",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "deviceId",
        "category",
        "name",
        "values",
        "receivedAt"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "deviceId": {
          "$ref": "#/$defs/Identifier"
        },
        "sessionId": {
          "$ref": "#/$defs/Identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "category": {
          "type": "string",
          "enum": [
            "connection",
            "input",
            "telemetry",
            "motion",
            "sensor",
            "safety",
            "program",
            "diagnostic"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "values": {
          "$ref": "#/$defs/JsonObject"
        },
        "sourceTimestamp": {
          "type": "string",
          "format": "date-time"
        },
        "receivedAt": {
          "type": "string",
          "format": "date-time"
        },
        "historical": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "DeviceDescriptor": {
      "title": "DeviceDescriptor",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceId",
        "displayName",
        "deviceType",
        "model",
        "adapterId",
        "adapterVersion",
        "physical",
        "capabilities"
      ],
      "properties": {
        "deviceId": {
          "$ref": "#/$defs/Identifier"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "deviceType": {
          "type": "string",
          "enum": ["robot", "input", "xr_client", "virtual", "bridge"]
        },
        "model": {
          "$ref": "#/$defs/Identifier"
        },
        "adapterId": {
          "$ref": "#/$defs/Identifier"
        },
        "adapterVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "physical": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/CapabilityIdentifier"
          }
        },
        "safetyProfile": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "CommandResult": {
      "title": "CommandResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["commandId", "deviceId", "status", "recordedAt"],
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "deviceId": {
          "$ref": "#/$defs/Identifier"
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "completed",
            "rejected",
            "duplicate",
            "expired",
            "failed"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        },
        "details": {
          "$ref": "#/$defs/JsonObject"
        }
      }
    },
    "ProtocolError": {
      "title": "ProtocolError",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "correlationId", "recoverySuggestion"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "DEVICE_NOT_FOUND",
            "DEVICE_OFFLINE",
            "DEVICE_NOT_ASSIGNED",
            "DEVICE_LEASE_CONFLICT",
            "DEVICE_NOT_ARMED",
            "DEVICE_CAPABILITY_UNSUPPORTED",
            "COMMAND_EXPIRED",
            "COMMAND_DUPLICATE",
            "SAFETY_POLICY_DENIED",
            "PROTOCOL_VERSION_UNSUPPORTED",
            "INVALID_MESSAGE"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "deviceId": {
          "$ref": "#/$defs/Identifier"
        },
        "sessionId": {
          "$ref": "#/$defs/Identifier"
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "recoverySuggestion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "details": {
          "$ref": "#/$defs/JsonObject"
        }
      }
    },
    "FabricSchemaVersion": {
      "title": "FabricSchemaVersion",
      "const": "1.0",
      "type": "string"
    },
    "CapabilityDirection": {
      "title": "CapabilityDirection",
      "type": "string",
      "enum": ["publish", "consume", "bidirectional"]
    },
    "FabricSafetyClassification": {
      "title": "FabricSafetyClassification",
      "type": "string",
      "enum": [
        "none",
        "informational",
        "bounded_physical",
        "flight",
        "electrical"
      ]
    },
    "FabricDataClassification": {
      "title": "FabricDataClassification",
      "type": "string",
      "enum": [
        "public",
        "operational",
        "student",
        "source_code",
        "voice_transcript",
        "biosignal_derived",
        "sensitive_raw",
        "secret"
      ]
    },
    "FabricLatencyClass": {
      "title": "FabricLatencyClass",
      "type": "string",
      "enum": [
        "safety_critical",
        "interactive",
        "ui_feedback",
        "conversational",
        "bulk"
      ]
    },
    "SimulatorAvailability": {
      "title": "SimulatorAvailability",
      "type": "string",
      "enum": ["included", "recorded_replay", "external", "none"]
    },
    "CapabilityDescriptor": {
      "title": "CapabilityDescriptor",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "direction",
        "latencyClass",
        "safetyClassification",
        "dataClassification",
        "constraints"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/CapabilityIdentifier"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
        },
        "direction": {
          "$ref": "#/$defs/CapabilityDirection"
        },
        "schemaRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "units": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "maximumRateHz": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "latencyClass": {
          "$ref": "#/$defs/FabricLatencyClass"
        },
        "safetyClassification": {
          "$ref": "#/$defs/FabricSafetyClassification"
        },
        "dataClassification": {
          "$ref": "#/$defs/FabricDataClassification"
        },
        "constraints": {
          "$ref": "#/$defs/JsonObject"
        }
      }
    },
    "PluginManifest": {
      "title": "PluginManifest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "pluginId",
        "pluginVersion",
        "runtimeVersion",
        "displayName",
        "adapterMode",
        "configurationSchema",
        "publishedCapabilities",
        "consumedCapabilities",
        "requiredPermissions",
        "safetyClassification",
        "dataClassifications",
        "simulatorAvailability"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/FabricSchemaVersion"
        },
        "pluginId": {
          "$ref": "#/$defs/Identifier"
        },
        "pluginVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "runtimeVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "adapterMode": {
          "type": "string",
          "enum": ["in_process", "out_of_process"]
        },
        "configurationSchema": {
          "$ref": "#/$defs/JsonObject"
        },
        "publishedCapabilities": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/CapabilityDescriptor"
          }
        },
        "consumedCapabilities": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/CapabilityDescriptor"
          }
        },
        "requiredPermissions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "safetyClassification": {
          "$ref": "#/$defs/FabricSafetyClassification"
        },
        "dataClassifications": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/FabricDataClassification"
          }
        },
        "simulatorAvailability": {
          "$ref": "#/$defs/SimulatorAvailability"
        },
        "vendor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "FabricNodeConnectionState": {
      "title": "FabricNodeConnectionState",
      "type": "string",
      "enum": [
        "registering",
        "connected",
        "degraded",
        "unavailable",
        "disconnected",
        "unsafe"
      ]
    },
    "FabricNodeHealthState": {
      "title": "FabricNodeHealthState",
      "type": "string",
      "enum": ["healthy", "degraded", "unhealthy", "unknown"]
    },
    "IntegrationNode": {
      "title": "IntegrationNode",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "nodeId",
        "pluginId",
        "pluginVersion",
        "runtimeVersion",
        "hostId",
        "siteId",
        "roomId",
        "displayName",
        "connectionState",
        "healthState",
        "physical",
        "simulated",
        "publishedCapabilities",
        "consumedCapabilities",
        "configurationSchema",
        "safetyClassification",
        "dataClassifications",
        "simulatorAvailable",
        "lastSeenAt",
        "metadata"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/FabricSchemaVersion"
        },
        "nodeId": {
          "$ref": "#/$defs/Identifier"
        },
        "pluginId": {
          "$ref": "#/$defs/Identifier"
        },
        "pluginVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "runtimeVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "hostId": {
          "$ref": "#/$defs/Identifier"
        },
        "siteId": {
          "$ref": "#/$defs/Identifier"
        },
        "roomId": {
          "$ref": "#/$defs/Identifier"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "connectionState": {
          "$ref": "#/$defs/FabricNodeConnectionState"
        },
        "healthState": {
          "$ref": "#/$defs/FabricNodeHealthState"
        },
        "physical": {
          "type": "boolean"
        },
        "simulated": {
          "type": "boolean"
        },
        "publishedCapabilities": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/CapabilityDescriptor"
          }
        },
        "consumedCapabilities": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/CapabilityDescriptor"
          }
        },
        "configurationSchema": {
          "$ref": "#/$defs/JsonObject"
        },
        "safetyClassification": {
          "$ref": "#/$defs/FabricSafetyClassification"
        },
        "dataClassifications": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/FabricDataClassification"
          }
        },
        "simulatorAvailable": {
          "type": "boolean"
        },
        "requiredPermissions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time"
        },
        "metadata": {
          "$ref": "#/$defs/JsonObject"
        }
      }
    },
    "HealthReport": {
      "title": "HealthReport",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "nodeId",
        "reportedAt",
        "connectionState",
        "healthState",
        "metrics"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/FabricSchemaVersion"
        },
        "nodeId": {
          "$ref": "#/$defs/Identifier"
        },
        "reportedAt": {
          "type": "string",
          "format": "date-time"
        },
        "connectionState": {
          "$ref": "#/$defs/FabricNodeConnectionState"
        },
        "healthState": {
          "$ref": "#/$defs/FabricNodeHealthState"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "batteryPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "metrics": {
          "$ref": "#/$defs/JsonObject"
        }
      }
    },
    "FabricEventEnvelope": {
      "title": "FabricEventEnvelope",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messageId",
        "schemaVersion",
        "messageType",
        "topic",
        "sourceNodeId",
        "sourceCapability",
        "siteId",
        "roomId",
        "sessionId",
        "timestamp",
        "monotonicTimestamp",
        "sequence",
        "ttlMs",
        "dataClassification",
        "payload"
      ],
      "properties": {
        "messageId": {
          "type": "string",
          "format": "uuid"
        },
        "schemaVersion": {
          "$ref": "#/$defs/FabricSchemaVersion"
        },
        "messageType": {
          "const": "event",
          "type": "string"
        },
        "topic": {
          "$ref": "#/$defs/CapabilityIdentifier"
        },
        "sourceNodeId": {
          "$ref": "#/$defs/Identifier"
        },
        "sourceCapability": {
          "$ref": "#/$defs/CapabilityIdentifier"
        },
        "siteId": {
          "$ref": "#/$defs/Identifier"
        },
        "roomId": {
          "$ref": "#/$defs/Identifier"
        },
        "sessionId": {
          "$ref": "#/$defs/Identifier"
        },
        "participantId": {
          "$ref": "#/$defs/Identifier"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "monotonicTimestamp": {
          "type": "integer",
          "minimum": 0
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "causationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ttlMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "dataClassification": {
          "$ref": "#/$defs/FabricDataClassification"
        },
        "payload": {
          "$ref": "#/$defs/JsonObject"
        }
      }
    },
    "FabricCommandPriority": {
      "title": "FabricCommandPriority",
      "type": "string",
      "enum": [
        "emergency_stop",
        "safety_engine",
        "instructor_override",
        "lesson_automation",
        "student_interaction",
        "autonomous_agent"
      ]
    },
    "FabricRoleTarget": {
      "title": "FabricRoleTarget",
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "FabricCommandRequest": {
      "title": "FabricCommandRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messageId",
        "schemaVersion",
        "messageType",
        "action",
        "target",
        "sessionId",
        "parameters",
        "priority",
        "idempotencyKey",
        "requestedAt",
        "ttlMs",
        "safetyProfile",
        "correlationId"
      ],
      "properties": {
        "messageId": {
          "type": "string",
          "format": "uuid"
        },
        "schemaVersion": {
          "$ref": "#/$defs/FabricSchemaVersion"
        },
        "messageType": {
          "const": "command.requested",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/CapabilityIdentifier"
        },
        "target": {
          "$ref": "#/$defs/FabricRoleTarget"
        },
        "sessionId": {
          "$ref": "#/$defs/Identifier"
        },
        "parameters": {
          "$ref": "#/$defs/JsonObject"
        },
        "priority": {
          "$ref": "#/$defs/FabricCommandPriority"
        },
        "idempotencyKey": {
