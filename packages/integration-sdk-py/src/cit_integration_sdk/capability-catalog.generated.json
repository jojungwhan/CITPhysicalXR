  "capabilities": {
    "power_switch_set": {
      "name": "power.switch.set",
      "version": "1.0",
      "maximumRateHz": 1,
      "latencyClass": "interactive",
      "safetyClassification": "electrical",
      "dataClassification": "operational",
      "constraints": {
        "arguments": {
          "on": {
            "type": "boolean"
          }
        }
      }
    },
    "power_switch_state": {
      "name": "power.switch.state",
      "version": "1.0",
      "maximumRateHz": 1,
      "latencyClass": "ui_feedback",
      "safetyClassification": "informational",
      "dataClassification": "operational",
      "constraints": {
        "payload": {
          "on": {
            "type": "boolean"
          }
        }
      }
    },
    "power_electrical_state": {
      "name": "telemetry.power.electrical",
      "version": "1.0",
      "maximumRateHz": 1,
      "latencyClass": "ui_feedback",
      "safetyClassification": "informational",
      "dataClassification": "operational",
      "constraints": {
        "payload": {
          "activePowerWatts": {
            "type": "number",
            "unit": "W"
          },
          "voltageVolts": {
            "type": "number",
            "unit": "V"
          },
          "activeCurrentAmperes": {
            "type": "number",
            "unit": "A"
          },
          "cumulativeEnergyKilowattHours": {
            "type": "number",
            "unit": "kWh"
          },
          "frequencyHertz": {
            "type": "number",
            "unit": "Hz"
          },
          "powerFactorRatio": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        }
      }
    },
    "gesture_velocity": {
      "name": "interaction.gesture.velocity",
      "version": "1.0",
      "maximumRateHz": 15,
      "latencyClass": "interactive",
      "safetyClassification": "informational",
      "dataClassification": "operational",
      "constraints": {
        "payload": {
          "forwardMetersPerSecond": {
            "minimum": -0.35,
            "maximum": 0.35
          },
          "rightMetersPerSecond": {
            "minimum": -0.35,
            "maximum": 0.35
          },
          "clockwiseRadiansPerSecond": {
            "minimum": -0.6108652382,
            "maximum": 0.6108652382
          }
        }
      }
    },
    "tracking_status": {
      "name": "telemetry.tracking.status",
