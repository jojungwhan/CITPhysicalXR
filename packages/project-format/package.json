{
  "name": "@citxr/project-format",
  "version": "0.0.0",
  "private": true,
  "description": "Versioned CIT Physical XR project file, its schema, and its source-of-truth rules.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./cit-project.schema.json": "./schemas/cit-project.schema.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
